# ============================================================
# ZYRALUXE JEWELLERY AI API
# ============================================================

APP_ENV=development

API_HOST=127.0.0.1
API_PORT=8000

# For local testing:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For the real WordPress site, use for example:
# CORS_ORIGINS=https://www.zyraluxe.com,https://zyraluxe.com

# Optional server-side access key.
# DO NOT put a secret value into public WordPress JavaScript.
CHATBOT_API_ACCESS_KEY=

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

MAX_MESSAGE_LENGTH=4000
